#include<Trade/Trade.mqh>
#include <Trader/Bfunctions.mqh>

CTrade trade;

input static int closingTradingHour = 21;
input static int closingTradingMinutes = 44;

double SlPrice = 0;
double SL = 0;
double RiskValue = 200;
double ProfitPips = 0;
double SlPips = 0;
double BePips = 0;
double HRPips = 0;
double RPips = 0;

double HRProfitPips = 0;
double RProfitPips = 0;
double Lots = 0;

static int MaxTrades = 1;
static int TradeCount = 0;

MqlRates bar[];

input static int BuyingTimeHour = 13;
input static int BuyingTimeMin = 14;
static int TimeSec = 59;

int OnInit()
  {
//--- create timer
   //EventSetTimer(60);
   EventSetMillisecondTimer(500);
   ArraySetAsSeries(bar, true);
//---
   return(INIT_SUCCEEDED);
  }

void OnTimer()
  {
   double Ask = NormalizeDouble(SymbolInfoDouble(_Symbol, SYMBOL_ASK), _Digits);
   
  // Print("Ask price is : ", Ask);
   CopyRates(_Symbol, PERIOD_CURRENT, 0, 20, bar);
      
   //Print("Previous candle low - ", bar[1].low);
   
   MqlRates PriceInfo[];
   
   ArraySetAsSeries(PriceInfo, true);
   
   CopyRates(_Symbol, _Period, 0, 10, PriceInfo);
   
   double currCandleLow = NormalizeDouble(PriceInfo[0].low, _Digits);
   double prevCandleLow = NormalizeDouble(bar[1].low, _Digits);
   
   double MinPrice = fmin(currCandleLow, prevCandleLow);
   
   double ComparePrice = NormalizeDouble((Ask - MinPrice), _Digits);
   
  // Print("Compare price is : ", ComparePrice);
   if (ComparePrice <= 90*_Point)
   {
      SlPrice = Ask - 100*_Point;
      SL = 0.00100;
      ProfitPips = 200;
      BePips = 100;
      HRPips = 150;
      RPips = 170;
      HRProfitPips = 60;
      RProfitPips = BePips;
     // Print("SL is ", SlPrice);
   }else
   {
      SlPrice = NormalizeDouble(MinPrice, _Digits) - 10*_Point;
      SL = NormalizeDouble(Ask - SlPrice, _Digits);
      ProfitPips = MathRound(2 * SL / _Point);
      BePips = MathRound(Ask + 0.5*ProfitPips);
      HRPips = MathRound(Ask + 0.75*ProfitPips);
      RPips = MathRound(Ask + 0.85*ProfitPips);
      HRProfitPips = MathRound(Ask + 0.30*ProfitPips);
      RProfitPips = BePips;
   }
   
   MqlDateTime structTime;
   TimeLocal(structTime);
   
   structTime.hour = BuyingTimeHour;
   structTime.min = BuyingTimeMin;
   structTime.sec = TimeSec;
   
   datetime timeBuy = StructToTime(structTime);
   
   //ObjectDelete(0,"SL Line");
     
   Lots = CalLotSize(RiskValue, SL);
   //Print("Lotsize is : ", Lots);
   SlPips = MathRound(SL / _Point);
   Print("SlPips is : ", SlPips);
   Print("Profitpips is ", ProfitPips);
   /*Print("BEPips is ", BePips);
   Print("HRPips is : ", HRPips);
   Print("RPips is : ", RPips);
   Print("HRProfit is : ", HRProfitPips);*/
   
   if(PositionsTotal() == 0)
   if(TradeCount < MaxTrades)
   if(timeBuy == TimeLocal())
   {
      //ObjectCreate(0,"SL Line",OBJ_HLINE,0,0, SlPrice);
      trade.Buy(Lots, _Symbol, Ask, Ask - SlPips*_Point, Ask + ProfitPips*_Point, NULL);
      TradeCount = TradeCount + 1;
   }
      CheckBuyBreakEvenStop(Ask);
      MoveSLToOneR(Ask);
      CloseTradeBeforeEvent(closingTradingHour, closingTradingMinutes);
}


